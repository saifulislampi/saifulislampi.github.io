@inproceedings{islam2026portable,
  abbr        = {eScience},
  title       = {Portable By Design: Deploying Notebook-based Scientific Workflows across HPC Clusters},
  author      = {Islam, Md Saiful and Azaz, Talha and Ahmad, Raza and Hossain, A S M Shahadat and Baig, Furqan and Wang, Shaowen and Lannon, Kevin and Malik, Tanu and Thain, Douglas},
  booktitle   = {2026 IEEE 22nd International Conference on eScience (eScience), Poster Paper},
  year        = {2026},
  html        = {https://floability.github.io},
  abstract    = {Notebooks are the default interface for exploratory science, but scaling them into distributed HPC workflows remains hard: provisioning and data staging are usually hand-coded into notebook cells, so the same notebook rarely runs unmodified elsewhere. We present an ecosystem that externalizes these concerns instead of burying them in code. TaskVine supplies scalable, fault-tolerant distributed execution. A backpack captures a notebook's software, data, and compute requirements as a single portable specification. Floability Audit observes a workflow's execution and automatically turns it into a backpack. Floability then provisions the backpack unmodified across heterogeneous HPC sites, resolving and caching data through a declarative data layer. Together, these pieces make portability a property of the ecosystem rather than a discipline imposed on the notebook.},
  bibtex_show = {true}
}

